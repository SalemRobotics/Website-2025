                }
                > p {
                    width: 80%;
                    text-align: justify;
                    font-size: 1.125rem;
                }
                #contacts {
                    display: flex;
                    flex-direction: row;
                    justify-content: space-around;
                    width: 100%;
                    div {
                        margin-block: 1em;
                        > h2 {
                            font-weight: 700;
                        }
                        > p {
                            margin: 0;
                        }
                    }
                }
            }
            #mailing-and-disclaimer {
                display: flex;
                flex-direction: row;
                justify-content: space-around;
                width: 100%;
                padding-block: 1em;

                #mailing {
                    white-space: nowrap;
                    width: fit-content;

                    h2 {
                        margin: 0;
                    }
                }
                #disclaimer {
                    flex: 1 3 auto;
                    max-width: 65%;
                    padding: 1.5vw;
                    border-top: 1px solid var(--text);
                    border-left: 1px solid var(--text);

                    sup {
                        line-height: 0;
                    }
                }
            }
        }
    </style>
